{
  "name": "4vl",
  "version": "1.0.0",
  "description": "Four-valued logic vectors",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "npm run build; npm run doc",
    "mjs": "tsc -d && mv dist/index.js dist/index.mjs",
    "cjs": "tsc -m commonjs",
    "build": "npm run mjs && npm run cjs",
    "test": "jest",
    "doc": "typedoc --out dist/docs src/"
  },
  "author": "Marcos Cervetto",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20",
    "jest": "^29.5.0",
    "jsverify": "^0.8.4",
    "lodash": "^4.17.21",
    "ts-jest": "^29.0.5",
    "typedoc": "^0.23.28",
    "typescript": "^4.9.3"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
